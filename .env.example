# Dify Local Docker API Configuration (DO NOT COMMIT REAL KEYS)
DIFY_BASE_URL=http://localhost/v1
DIFY_WORKFLOW_API_KEY=app-your-dify-workflow-api-key-here
DIFY_USER_ID=trendee-qa-runner

# Default Word Count Mode: pdf_default (1200-1500) | json_override (uses JSON target_words)
WORD_COUNT_MODE=pdf_default

# Optional: 100-SKU Production Image API Configuration (Compliant Official APIs)
# Supported providers: openai | gemini | flux_bfl | mock
IMAGE_PROVIDER=mock
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
BFL_API_KEY=your-flux-bfl-key-here
IMAGE_SITE_BASE_URL=https://example.com
